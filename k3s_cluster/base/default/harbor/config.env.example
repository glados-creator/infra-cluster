# config.env
# Non-secret settings, shared across core / registryctl / jobservice /
# trivy-adapter / exporter via envFrom. Irrelevant vars are simply ignored
# by binaries that don't read them.
#
# NOTE: verify variable names against the exact Harbor tag you're pulling:
# https://github.com/goharbor/harbor/tree/main/make/photon/prepare/templates
# (core/env.jinja, jobservice/env.jinja etc.) — names have drifted slightly
# between releases and this list is compiled from the current main branch.

# --- Global / external URL ---
# EXT_ENDPOINT is what gets baked into pull/push instructions, the token
# realm, and CSRF checks. It MUST be the address clients actually use
# (i.e. what's behind Traefik), not a pod-internal address.
EXT_ENDPOINT=http://harbor.main.home
LOG_LEVEL=info
LOG_LOCATION=/var/log/harbor
WITH_TRIVY=true

# --- Database (in-pod postgres, reached over localhost) ---
DATABASE_TYPE=postgresql
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=registry
POSTGRESQL_USERNAME=postgres
POSTGRESQL_SSLMODE=disable
POSTGRESQL_MAX_IDLE_CONNS=50
POSTGRESQL_MAX_OPEN_CONNS=100
# Non-secret half of the vanilla postgres image's own env contract.
# (POSTGRES_PASSWORD is the secret half — see secret.env)
POSTGRES_USER=postgres
POSTGRES_DB=registry

# --- Redis (in-pod, one DB index per consumer to avoid key collisions) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Internal component URLs (same pod -> localhost) ---
CORE_URL=http://127.0.0.1:8080
CORE_LOCAL_URL=http://127.0.0.1:8080
JOBSERVICE_URL=http://127.0.0.1:8082
REGISTRY_URL=http://127.0.0.1:5000
REGISTRY_CONTROLLER_URL=http://127.0.0.1:8081
# Token realm is fetched by the DOCKER CLIENT directly (bearer-token
# auth flow), so unlike the URLs above this one MUST be externally
# reachable through Traefik, not 127.0.0.1.
TOKEN_SERVICE_URL=http://harbor.main.home/service/token
TRIVY_ADAPTER_URL=http://127.0.0.1:8083
# Trivy-adapter's own listen address — 8080 is already core's, so move it.
SCANNER_API_SERVER_ADDR=:8083

# --- Auth ---
AUTH_MODE=db_auth
SELF_REGISTRATION=true

# --- Email (optional) ---
EMAIL_HOST=smtp.a.com
EMAIL_PORT=25
EMAIL_FROM=admin@a.com
EMAIL_SSL=false
EMAIL_INSECURE=false

# --- Metrics ---
METRIC_ENABLED=true
METRIC_PATH=/metrics
METRIC_PORT=8080

# --- Scanner (Trivy) ---
SCANNER_TRIVY_URL=http://127.0.0.1:8083
# SCANNER_TRIVY_CUSTOM_CA_PATH=/harbor_cust_cert

# --- Jobservice ---
JOBSERVICE_WEBHOOK_JOB_MAX_RETRY=3
