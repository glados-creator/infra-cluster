# secret.env
# --- Database ---
POSTGRESQL_PASSWORD=changeme123
# Vanilla postgres image's own bootstrap var — same value as above,
# duplicated under the key postgres:18-alpine actually requires.
POSTGRES_PASSWORD=changeme123

# --- Harbor Admin ---
HARBOR_ADMIN_PASSWORD=Harbor12345

# --- Core Secret (shared HMAC between core & jobservice, 16+ random chars) ---
CORE_SECRET=randomcoresecret1234

# --- Job Service Secret (verified by core, 16+ random chars) ---
JOBSERVICE_SECRET=randomjobsecret1234

# --- Registry basic-auth credential used by core/jobservice for GC ---
# NOTE: verify this is actually wired into registry's auth config for
# your Harbor version — some releases use it, some rely on token auth
# only. Harmless to leave set either way.
REGISTRY_CREDENTIAL_USERNAME=harbor_registry_user
REGISTRY_CREDENTIAL_PASSWORD=randomregistrypass
