# Generate a random 32-character encryption key (change this!)
# openssl rand -base64 24
N8N_ENCRYPTION_KEY="your-32-character-encryption-key"
# Disable secure cookie if behind HTTP (Authentik handles auth)
N8N_SECURE_COOKIE="false"
# Optional: set host and port for URL generation
N8N_HOST="n8n.code.private.home"
N8N_PORT="4429"
# Use SQLite (default) – persistence is via volume
DB_TYPE="sqlite"
DB_SQLITE_DATABASE="/home/node/.n8n/database.sqlite"