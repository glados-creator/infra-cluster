# ---- Core ----
WEBUI_SECRET_KEY= "your-secret-key-here"   # Generate with: openssl rand -base64 32
# ---- Ollama connection ----
OLLAMA_BASE_URL= "http://private-code-ollama-service.prod-private.svc.cluster.local:4431"   
# Adjust if your Ollama is elsewhere
# ---- Authentication ----
# Set to False for single-user mode (no login screen)
# WEBUI_AUTH= "False"
# ---- Optional: Disable telemetry ----
DO_NOT_TRACK= "true"