# ---- Core ----
AUTH_ENABLED="true"
ODYSSEUS_ADMIN_USER="admin"
# The first admin password is printed in the container logs.
# Set it here or let it auto-generate.
ODYSSEUS_ADMIN_PASSWORD=""  # auto-generate; check logs for the password
DATABASE_URL="sqlite:////app/data/app.db"
ALLOWED_ORIGINS="http://localhost,http://127.0.0.1,https://odysseus.code.private.home"
SECURE_COOKIES="false"  # set to "true" if using HTTPS
# ---- LLM / Search ----
OLLAMA_BASE_URL="http://private-code-ollama-service.private.svc.cluster.local:4431"  # adjust if you have Ollama
# OPENAI_API_KEY=""  # optional
# SEARXNG_INSTANCE="http://searxng:8080"  # if you deploy SearXNG separately
# ---- Paths ----
APP_DATA_DIR="/app/data"
APP_LOGS_DIR="/app/logs"