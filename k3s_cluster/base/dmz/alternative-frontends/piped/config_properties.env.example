# Full reference: https://raw.githubusercontent.com/TeamPiped/Piped-Backend/master/config.properties
# NOTE: hibernate.connection.password below must match POSTGRES_PASSWORD in
# secret.env - kustomize does not cross-reference these for you.

# The port to Listen on.
PORT:8080
HTTP_WORKERS:2

# Proxy - the media/video proxy hostname, own A record recommended
PROXY_PART:https://piped-proxy.alt.dmz.home

# Public API URL (this backend's own hostname)
API_URL:https://piped-api.alt.dmz.home

# Public Frontend URL
FRONTEND_URL:https://piped.alt.dmz.home

COMPROMISED_PASSWORD_CHECK:true
DISABLE_REGISTRATION:false
FEED_RETENTION:30
DISABLE_TIMERS:false
SPONSORBLOCK_SERVERS:https://sponsor.ajay.app
DISABLE_RYD:true
DISABLE_LBRY:false
SUBSCRIPTIONS_EXPIRY:30
CONSENT_COOKIE:true

# Hibernate / DB - postgres sidecar shares the pod network namespace
hibernate.connection.url:jdbc:postgresql://127.0.0.1:5432/piped
hibernate.connection.driver_class:org.postgresql.Driver
hibernate.dialect:org.hibernate.dialect.PostgreSQLDialect
hibernate.connection.username:piped
hibernate.connection.password:CHANGE_ME
