# Fill in: <FSID>, the mon endpoint string, and <HEALTHCHECKER_KEY>
# (output of `ceph fsid`, `ceph mon dump`, and `ceph auth print-key client.healthchecker`)

apiVersion: v1
kind: Secret
metadata:
  name: rook-ceph-mon
  namespace: rook-ceph
type: kubernetes.io/rook
stringData:
  cluster-name: rook-ceph
  fsid: "<FSID>"
  admin-secret: ""                 # left empty, we're not giving Rook a client.admin key
  mon-secret: "mon-secret"         # placeholder value, not actually validated
  ceph-username: "client.healthchecker"
  ceph-secret: "<HEALTHCHECKER_KEY>"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: rook-ceph-mon-endpoints
  namespace: rook-ceph
data:
  data: "a=192.168.1.<XXX>:6789"   # replace with your real `ceph mon dump` output
  mapping: "{}"
  maxMonId: "0"                    # (number of mons - 1)
---
apiVersion: ceph.rook.io/v1
kind: CephCluster
metadata:
  name: rook-ceph
  namespace: rook-ceph
spec:
  external:
    enable: true
  crashCollector:
    disable: true
  # dataDirHostPath: /var/lib/rook # mkdir /var/lib/rook
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: rook-ceph-csi-config
  namespace: rook-ceph
data:
  csi-cluster-config-json: |
    [{"clusterID":"rook-ceph","monitors":["192.168.1.<XXX>:6789"],"namespace":""}]
---
apiVersion: csi.ceph.io/v1
kind: CephConnection
metadata:
  name: rook-ceph
  namespace: rook-ceph
spec:
  monitors:
    - "192.168.1.<XXX>:6789"
---
apiVersion: csi.ceph.io/v1
kind: ClientProfile
metadata:
  name: rook-ceph
  namespace: rook-ceph
spec:
  cephConnectionRef:
    name: rook-ceph
  cephFs:
    subVolumeGroup: k8s-colosseum